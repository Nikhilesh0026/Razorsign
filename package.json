{
  "name": "framwork",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --headed",
    "test:ci": "npx playwright test",
    "smoke": "npx playwright test --headed --grep \"@smoke\"",
    "smoke:ci": "npx playwright test --grep \"@smoke\"",
    "regression": "npx playwright test --headed --grep \"@regression\"",
    "regression:ci": "npx playwright test --grep \"@regression\"",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:headless": "npx playwright test --headed=false",
    "test:one-worker": "npx playwright test --workers=1",
    "test:chromium": "npx playwright test --project=chromium",
    "test:request": "npx playwright test tests/request.spec.js --headed",
    "test:approval": "npx playwright test tests/request.spec.js --headed --grep \"Approve request\"",
    "test:failed": "npx playwright test --last-failed",
    "test:changed": "npx playwright test --only-changed",
    "test:update-snapshots": "npx playwright test --update-snapshots",
    "codegen": "npx playwright codegen",
    "report": "npx playwright show-report",
    "trace": "npx playwright show-trace",
    "install:browsers": "npx playwright install",
    "install:deps": "npx playwright install --with-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2"
  }
}
